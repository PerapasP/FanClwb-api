generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  user_id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  social_id     String?      @unique @db.VarChar
  fullname      String?      @db.VarChar
  email         String?      @unique @db.VarChar
  phone_number  String?      @db.VarChar
  password      String?      @db.VarChar
  auth_provider AuthProvider @default(google)
  coins         Int          @default(0)
  bonus_coins   Int          @default(0)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?    @updatedAt @db.Timestamptz(6)
  is_verified   Boolean?     @default(false)

  coin_transactions      coin_transactions[]
  coin_bonus_expirations coin_bonus_expirations[]
  refresh_tokens         refresh_tokens[]
}

model refresh_tokens {
  id         String   @id @default(uuid())
  user_id    String   @db.Uuid
  token_hash String
  token_id   String   @unique
  user_agent String?
  ip_address String?
  expires_at DateTime
  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [user_id])

  @@index([user_id, expires_at])
}

enum AuthProvider {
  google
  email
}

// Package coins
model coin_packages {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coins          Int
  bonus_coins    Int       @default(0)
  price_thb      Int
  original_price Int?
  discount_label String?   @db.VarChar
  is_active      Boolean   @default(true)
  is_popular     Boolean   @default(false)
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @updatedAt @db.Timestamptz(6)

  coin_topups coin_topups[]

  @@index([is_active, sort_order])
}

model coin_transactions {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String              @db.Uuid
  type                CoinTransactionType // topup, spend, bonus, refund, expire
  amount              Int // จำนวนคอยน์ที่เปลี่ยนแปลง (+ หรือ -)
  bonus_amount        Int                 @default(0) // โบนัสที่ได้รับ (ถ้ามี)
  balance_after       Int // balance หลัง transaction (snapshot)
  bonus_balance_after Int                 @default(0)
  ref_id              String?             @db.VarChar // อ้างอิง เช่น payment_id, order_id
  note                String?             @db.VarChar // หมายเหตุ
  created_at          DateTime            @default(now()) @db.Timestamptz(6)

  user  users        @relation(fields: [user_id], references: [user_id])
  topup coin_topups? // ถ้า type = topup จะมี record นี้

  @@index([user_id])
  @@index([type])
}

model coin_topups {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id  String      @unique @db.Uuid
  package_id      String?     @db.Uuid
  coins_purchased Int // คอยน์ที่ซื้อ (ไม่รวมโบนัส)
  bonus_coins     Int         @default(0)
  amount_thb      Int // ยอดเงินจริงที่จ่าย (บาท)
  payment_method  String?     @db.VarChar // promptpay, credit_card ฯลฯ
  payment_ref     String?     @db.VarChar // ref จาก payment gateway
  status          TopupStatus @default(pending)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  paid_at         DateTime?   @db.Timestamptz(6)

  transaction coin_transactions @relation(fields: [transaction_id], references: [id])
  package     coin_packages?    @relation(fields: [package_id], references: [id])
}

model coin_bonus_expirations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  amount     Int
  expires_at DateTime @db.Timestamptz(6)
  is_expired Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [user_id])

  @@index([user_id, expires_at])
}

enum CoinTransactionType {
  topup // เติมคอยน์
  spend // ใช้คอยน์
  bonus // ได้รับโบนัส
  refund // คืนคอยน์
  expire // โบนัสหมดอายุ
}

enum TopupStatus {
  pending // รอชำระเงิน
  success // ชำระเงินสำเร็จ
  failed // ล้มเหลว
  refunded // คืนเงินแล้ว
}

// ============================================================
//  ARTIST
// ============================================================
model artists {
  artist_id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artist_category_id String        @db.Uuid
  label_id           String        @db.Uuid
  image_url          String?       @db.VarChar(255)
  name               String?       @db.VarChar(100)
  slug               String        @unique @db.VarChar(100)
  status             Boolean       @default(true)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?     @updatedAt @db.Timestamptz(6)

  // relations
  category       artist_categories @relation(fields: [artist_category_id], references: [artist_category_id])
  label          labels            @relation(fields: [label_id], references: [label_id])
  detail         artists_detail?
  sns_links      artist_sns[]
  members        artist_members[]

  @@index([label_id])
  @@index([artist_category_id])
  @@index([status])
}

model artists_detail {
  artist_detail_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artist_id        String    @unique @db.Uuid
  fullname         String?   @db.VarChar(100)
  fullname_eng     String?   @db.VarChar(100)
  nickname         String?   @db.VarChar(100)
  nickname_eng     String?   @db.VarChar(100)
  birth_date       DateTime? @db.Date
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)

  // relations
  artist artists @relation(fields: [artist_id], references: [artist_id], onDelete: Cascade)
}

model artist_categories {
  artist_category_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String    @db.VarChar(50)
  slug               String    @unique @db.VarChar(50)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @updatedAt @db.Timestamptz(6)

  // relations
  artists artists[]
}

model labels {
  label_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(100)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  // relations
  artists artists[]
}

model artist_members {
  member_id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artist_id    String    @db.Uuid
  name         String    @db.VarChar(100)
  name_eng     String?   @db.VarChar(100)
  nickname     String?   @db.VarChar(50)
  nickname_eng String?   @db.VarChar(50)
  image_url    String?   @db.VarChar(255)
  birth_date   DateTime? @db.Date
  sort_order   Int       @default(0)
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @updatedAt @db.Timestamptz(6)

  // relations
  artist   artists       @relation(fields: [artist_id], references: [artist_id], onDelete: Cascade)
  sns_links member_sns[]

  @@index([artist_id, is_active])
  @@index([sort_order])
}

// ============================================================
//  SNS (Social Network) - ศิลปิน
// ============================================================
model sns_platforms {
  platform_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50) // Instagram, X (Twitter), TikTok, YouTube, Facebook, Weibo
  base_url    String?  @db.VarChar(255) // https://instagram.com/, https://x.com/
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // relations
  artist_sns artist_sns[]
  member_sns member_sns[]
}

model artist_sns {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artist_id   String    @db.Uuid
  platform_id String    @db.Uuid
  username    String    @db.VarChar(100)
  url         String    @db.VarChar(255)
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  // relations
  artist   artists       @relation(fields: [artist_id], references: [artist_id], onDelete: Cascade)
  platform sns_platforms @relation(fields: [platform_id], references: [platform_id])

  @@unique([artist_id, platform_id]) // 1 ศิลปิน : 1 platform
  @@index([artist_id])
}

model member_sns {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id   String    @db.Uuid
  platform_id String    @db.Uuid
  username    String    @db.VarChar(100)
  url         String    @db.VarChar(255)
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  // relations
  member   artist_members @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  platform sns_platforms  @relation(fields: [platform_id], references: [platform_id])

  @@unique([member_id, platform_id])
  @@index([member_id])
}
